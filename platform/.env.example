APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
ADMIN_TOKEN=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=0
# Override only on hosts whose audited regional mirror is materially faster.
PIP_INDEX_URL=https://pypi.org/simple

MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=qtail
MYSQL_USER=qtail
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_BIND_HOST=127.0.0.1
MYSQL_EXPOSED_PORT=3307

PRO_PRICE_CENTS=99900
# Keep manual mode until both merchant contracts, a real HTTPS callback domain,
# and the mounted key files have passed a low-value live settlement/refund test.
PAYMENT_MODE=manual_qr_verification
PAYMENT_PUBLIC_URL=
QTAIL_PAYMENT_SECRETS_DIR=./var/secrets/payment
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_MERCHANT_SERIAL=
WECHATPAY_PLATFORM_SERIAL=
WECHATPAY_API_BASE=https://api.mch.weixin.qq.com
PRO_DAILY_GENERATION_LIMIT=50
MAX_ACTIVE_GENERATIONS_PER_USER=5
QTAIL_FAKE_GENERATOR=0
# Local full acceptance sets this to 1 so the verified 56 MB catalog and the
# on-demand RLDS batch are mandatory instead of silently skipped.
QTAIL_CATALOG_EXPECT_AVAILABLE=0
QTAIL_WORKER_ENABLED=1
QTAIL_WORKER_MAX_ATTEMPTS=3
QTAIL_WORKER_POLL_SECONDS=1
QTAIL_WORKER_HEARTBEAT_SECONDS=15
QTAIL_WORKER_LEASE_SECONDS=120
QTAIL_WORKER_RETRY_BASE_SECONDS=5
QTAIL_RETENTION_SWEEP_SECONDS=60

# Read-only Pro catalog. Production preflight can require the exact verified
# MetaWorld/Sawyer archive before a release is activated.
QTAIL_SYNTHETIC_CATALOG_HOST_DIR=./var/catalog
REQUIRE_SYNTHETIC_CATALOG=0
QTAIL_SYNTHETIC_CATALOG_FILENAME=qtail-gate1-metaworld-sawyer-v0.1.0.tar.gz
QTAIL_SYNTHETIC_CATALOG_BYTES=56447787
QTAIL_SYNTHETIC_CATALOG_SHA256=c58b39d83a1a9f9d72533ed2f33d8280bbf7fee98e28b3c082fca116894d2fb0

WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080

# Dedicated local bindings for the temporary Cloudflare HTTPS preview overlay.
# These defaults avoid colliding with the regular preview/development stack.
CF_PREVIEW_MYSQL_BIND_HOST=127.0.0.1
CF_PREVIEW_MYSQL_EXPOSED_PORT=13318
CF_PREVIEW_WEB_BIND_HOST=127.0.0.1
CF_PREVIEW_WEB_PORT=18084

# Production edge/TLS overlay (`docker-compose.edge.yml`).
QTAIL_DOMAIN=qtail.example.com
EDGE_BIND_HOST=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Optional compatibility listener when an existing cloud firewall exposes a
# non-standard TLS port. Leave empty on a normal 80/443 deployment.
QTAIL_ALT_HTTPS_PORT=

# Ingress: `caddy` exposes host ports 80/443; `cloudflare` uses an outbound-only
# named Cloudflare Tunnel configured in the Cloudflare dashboard.
QTAIL_INGRESS_MODE=caddy
QTAIL_TLS_MODE=domain_acme
QTAIL_PUBLIC_IP=
QTAIL_CERTBOT_CONFIG_DIR=/opt/qtail/certbot/config
QTAIL_ACME_WEBROOT=/opt/qtail/acme-webroot
QTAIL_HOST_PROFILE=standard
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN_FILE=./var/secrets/cloudflare_tunnel_token
# Only change these if the private Compose subnet conflicts with the host/VPC.
QTAIL_TUNNEL_DNS_SUBNET=10.254.53.0/24
QTAIL_TUNNEL_DNS_IP=10.254.53.53
QTAIL_TUNNEL_CONNECTOR_IP=10.254.53.54
