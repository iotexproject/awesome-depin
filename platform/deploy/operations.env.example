# Store the real file at /etc/qtail/operations.env with mode 0600.
BACKUP_ENCRYPTION_PASSWORD=replace-with-secret-manager-value
# Optional group allowed to stream encrypted archives to a restricted off-host reader.
BACKUP_READ_GROUP=
# Leave empty until the real domain has a valid public certificate.
PUBLIC_URL=https://qtail.example.com
MAX_BACKUP_AGE_HOURS=30
MIN_FREE_DISK_PERCENT=15
FAILED_JOB_LIMIT_24H=5
MAX_QUEUE_AGE_SECONDS=1800
MAX_WORKER_PAUSE_SECONDS=1200
# Optional generic JSON webhook. Do not put customer data in alert messages.
ALERT_WEBHOOK_URL=
# Optional success/dead-man heartbeat. HTTPS only.
MONITOR_HEARTBEAT_URL=
# Set these REQUIRE flags to 1 only after the endpoints/credentials are installed.
REQUIRE_ALERT_WEBHOOK=0
# Automatic replication runs after every successful encrypted backup. Supported
# destinations: file:///absolute/path, s3://bucket/prefix, oss://bucket/prefix.
OFFSITE_BACKUP_URI=
OFFSITE_VERIFY_DOWNLOAD=1
# Defaults to /opt/qtail/backups/.offsite-latest.json under systemd.
OFFSITE_BACKUP_RECEIPT_FILE=
REQUIRE_OFFSITE_BACKUP=0
# Short-lived IP certificate renewal runtime. Keep the two-day validity floor so
# a failed renewal is detected well before the six-day certificate expires.
CERTBOT_BIN=/opt/qtail/certbot-venv/bin/certbot
QTAIL_CERTBOT_WORK_DIR=/opt/qtail/certbot/work
QTAIL_CERTBOT_LOGS_DIR=/opt/qtail/certbot/logs
QTAIL_CERT_MIN_VALIDITY_SECONDS=172800
# `production_stack.sh` derives the required ingress service from
# QTAIL_INGRESS_MODE, so monitoring cannot silently omit edge/cloudflared.
