[Unit]
Description=Q-Tail production health and backup freshness monitor
Requires=qtail.service
After=qtail.service

[Service]
Type=oneshot
WorkingDirectory=/opt/qtail/current/platform
EnvironmentFile=/etc/qtail/operations.env
Environment=ENV_FILE=/etc/qtail/qtail.env
Environment=COMPOSE_PROJECT_NAME=qtail-production
Environment=BACKUP_DIR=/opt/qtail/backups
ExecStart=/opt/qtail/current/platform/scripts/production_stack.sh monitor
